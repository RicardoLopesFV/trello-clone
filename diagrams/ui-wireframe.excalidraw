    {
      "id": "PzShwNXK4JsL79jKVFRMT",
      "type": "text",
      "x": 359.13374367663,
      "y": -134.65965575902845,
      "width": 571.7115478515625,
      "height": 740,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#45475a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 1347381161,
      "version": 241,
      "versionNonce": 803910889,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784730082532,
      "link": null,
      "locked": false,
      "text": ":root {\n  /* =========================================\n     1. PALETA BASE (Catppuccin Mocha)\n     ========================================= */\n  /* Fundos e Estruturas */\n  --crust: #11111b;   /* O mais escuro (Navbar/Header) */\n  --mantle: #181825;  /* Muito escuro (Fundo das Colunas) */\n  --base: #1e1e2e;    /* Escuro (Fundo do site/modais) */\n  --surface0: #313244; /* Cinza médio (Cartões) */\n  --surface1: #45475a; /* Cinza claro (Hover nos cartões) */\n\n  /* Cores Vibrantes (Acentos para Botões e Tags) */\n  --blue: #89b4fa;    /* Botão primário (Igual ao do Trello) */\n  --mauve: #cba6f7;   /* Tags/Labels roxas */\n  --green: #a6e3a1;   /* Tags de sucesso */\n  --peach: #fab387;   /* Avisos */\n  --red: #f38ba8;     /* Botões de deletar */\n\n  /* Textos */\n  --text: #cdd6f4;    /* Texto principal (Branco suave) */\n  --subtext0: #a6adc8; /* Texto secundário/ícones (Cinza) */\n\n  /* =========================================\n     2. MAPEAMENTO SEMÂNTICO (O Padrão Trello)\n     ========================================= */\n  /* O fundo do Quadro (Board) recebe uma cor vibrante ou gradiente */\n  --board-bg: linear-gradient(135deg, var(--mantle), var(--mauve)); \n  \n  /* As Colunas recebem a cor mais escura para criar foco */\n  --column-bg: var(--crust); \n  \n  /* Os Cartões saltam usando um cinza mais claro */\n  --card-bg: var(--surface0); \n  \n  /* Botões de ação direta */\n  --btn-primary: var(--blue);\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ":root {\n  /* =========================================\n     1. PALETA BASE (Catppuccin Mocha)\n     ========================================= */\n  /* Fundos e Estruturas */\n  --crust: #11111b;   /* O mais escuro (Navbar/Header) */\n  --mantle: #181825;  /* Muito escuro (Fundo das Colunas) */\n  --base: #1e1e2e;    /* Escuro (Fundo do site/modais) */\n  --surface0: #313244; /* Cinza médio (Cartões) */\n  --surface1: #45475a; /* Cinza claro (Hover nos cartões) */\n\n  /* Cores Vibrantes (Acentos para Botões e Tags) */\n  --blue: #89b4fa;    /* Botão primário (Igual ao do Trello) */\n  --mauve: #cba6f7;   /* Tags/Labels roxas */\n  --green: #a6e3a1;   /* Tags de sucesso */\n  --peach: #fab387;   /* Avisos */\n  --red: #f38ba8;     /* Botões de deletar */\n\n  /* Textos */\n  --text: #cdd6f4;    /* Texto principal (Branco suave) */\n  --subtext0: #a6adc8; /* Texto secundário/ícones (Cinza) */\n\n  /* =========================================\n     2. MAPEAMENTO SEMÂNTICO (O Padrão Trello)\n     ========================================= */\n  /* O fundo do Quadro (Board) recebe uma cor vibrante ou gradiente */\n  --board-bg: linear-gradient(135deg, var(--mantle), var(--mauve)); \n  \n  /* As Colunas recebem a cor mais escura para criar foco */\n  --column-bg: var(--crust); \n  \n  /* Os Cartões saltam usando um cinza mais claro */\n  --card-bg: var(--surface0); \n  \n  /* Botões de ação direta */\n  --btn-primary: var(--blue);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    }
